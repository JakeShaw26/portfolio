# Contact form email delivery (Resend — https://resend.com).
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.

# Server-only secret. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact submissions are delivered (your inbox).
CONTACT_TO_EMAIL=

# Verified sender on a domain you control in Resend, e.g. "Portfolio <hello@yourdomain.com>".
# Must NOT be the visitor's address (would fail SPF/DKIM).
CONTACT_FROM_EMAIL=

# Content (Contentful — https://www.contentful.com)
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.

# Space ID (already provisioned): 98ddc4l0fmm4
CONTENTFUL_SPACE_ID=

# Defaults to "master" if unset; only one environment exists currently.
CONTENTFUL_ENVIRONMENT=master

# Content Delivery API token (read-only, published content only) — distinct from
# the Management API token. Create at: Contentful → Space settings → API keys →
# Add API key → copy the "Content Delivery API - access token".
CONTENTFUL_DELIVERY_TOKEN=
