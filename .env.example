# Contact form email delivery (Resend — https://resend.com).
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.

# Server-only secret. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact submissions are delivered (your inbox).
CONTACT_TO_EMAIL=

# Verified sender on a domain you control in Resend, e.g. "Portfolio <hello@yourdomain.com>".
# Must NOT be the visitor's address (would fail SPF/DKIM).
CONTACT_FROM_EMAIL=
