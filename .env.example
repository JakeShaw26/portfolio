# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.

# Canonical site origin, no trailing slash (e.g. https://jakeshaw.dev).
# Read at BUILD time and inlined into the bundle — changing it requires a
# redeploy, not just a restart. Falls back to the value in src/lib/content/site.ts.
NEXT_PUBLIC_SITE_URL=

# Content (Contentful — https://www.contentful.com)

# Space ID (already provisioned): 98ddc4l0fmm4
CONTENTFUL_SPACE_ID=

# Defaults to "master" if unset; only one environment exists currently.
CONTENTFUL_ENVIRONMENT=master

# Content Delivery API token (read-only, published content only) — distinct from
# the Management API token. Create at: Contentful → Space settings → API keys →
# Add API key → copy the "Content Delivery API - access token".
CONTENTFUL_DELIVERY_TOKEN=
