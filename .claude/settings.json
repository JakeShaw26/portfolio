{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.pem)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Bash|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-files.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
